{
    "$schema": "https://raw.githubusercontent.com/AdminBolt/plugin-sdk/main/schema/plugin.schema.json",
    "id": "domain-policy",
    "name": "Domain Policy",
    "version": "1.0.0",
    "description": "Refuses domains matching a blocklist, tags the ones it allows, and shows the policy everywhere it applies.",
    "author": {
        "name": "Your Name",
        "url": "https://example.com"
    },
    "license": "MIT",
    "sdk": "^1.0",
    "panel": ">=1.9.0",
    "icon": "heroicon-o-shield-check",
    "runtime": {
        "php": "^8.2",
        "entrypoint": "public/index.php",
        "transport": "http"
    },
    "api": {
        "scopes": [
            "client:domains:read",
            "client:dns-records:write",
            "client:cli:execute"
        ]
    },
    "hooks": [
        {
            "event": "domain.creating",
            "blocking": true,
            "timeout": 5,
            "on_failure": "open"
        },
        "domain.created",
        "plugin.configured"
    ],
    "settings": [
        {
            "key": "blocked_suffixes",
            "type": "string",
            "label": "Blocked suffixes",
            "help": "Comma separated, for example: .test, .local, .invalid",
            "default": ".test, .local, .invalid"
        },
        {
            "key": "force_php_version",
            "type": "string",
            "label": "Force PHP version",
            "help": "Leave empty to let the hosting plan decide. Otherwise every new domain is created on this version."
        },
        {
            "key": "tag_records",
            "type": "bool",
            "label": "Add a TXT record to new domains",
            "default": true
        },
        {
            "key": "log_level",
            "type": "select",
            "label": "Log level",
            "default": "info",
            "options": {
                "debug": "Debug",
                "info": "Info",
                "warning": "Warning",
                "error": "Error"
            }
        }
    ],
    "ui": [
        {
            "panel": "client",
            "slug": "domain-policy",
            "title": "Domain Policy",
            "icon": "heroicon-o-shield-check",
            "group": "Domains"
        },
        {
            "panel": "admin",
            "slug": "policy-admin",
            "title": "Domain Policy",
            "icon": "heroicon-o-shield-check",
            "group": "Plugins"
        }
    ],
    "slots": [
        {
            "panel": "admin",
            "position": "content.start",
            "slug": "unconfigured-notice",
            "label": "A notice above every admin page while no suffix is blocked",
            "cache": 120
        },
        {
            "panel": "admin",
            "position": "footer",
            "slug": "footer-count",
            "label": "What the policy refused today, in the footer",
            "cache": 60
        },
        {
            "panel": "client",
            "position": "sidebar.nav.end",
            "slug": "policy-note",
            "label": "The blocked suffixes, under the customer's navigation",
            "cache": 300
        }
    ],
    "commands": [
        {
            "name": "php-version",
            "label": "Check the PHP version a site runs on",
            "description": "Runs php -v in the directory of a domain, so the page can show what the account really has rather than what the policy asked for.",
            "cwd": "required",
            "timeout": 30,
            "steps": [
                {
                    "program": "php",
                    "args": [
                        "-v"
                    ]
                }
            ]
        }
    ]
}
