{
    "name": "adminbolt/plugin-starter",
    "description": "A runnable AdminBolt panel plugin to copy and rename",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "adminbolt/plugin-sdk": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Acme\\DomainPolicy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acme\\DomainPolicy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
